# Default configuration for winvm.
# Don't edit this file for personal tweaks: put overrides in config.local.env
# (same syntax, gitignored, sourced after this file).

# --- Windows version --------------------------------------------------------
# Which images/<name>.env new VMs and `winvm build` use unless --image is given:
# win10, win11, win11-ltsc, server2025 (`winvm images` lists them).
IMAGE="win10"

# --- VM hardware ------------------------------------------------------------
VM_NAME="winvm"               # QEMU window title prefix
VM_CPUS=4
VM_RAM="8G"
VM_DISK_SIZE="80G"           # thin-provisioned qcow2, only grows as used

# uefi = UEFI + Secure Boot + TPM 2.0 (needed for BitLocker, VBS/Credential
#        Guard, Windows Hello, measured boot, Windows 11)
# bios = legacy BIOS/MBR, no TPM
# Fixed at build time; changing it needs `winvm build --force`.
FIRMWARE="uefi"
# Directory with OVMF_CODE.ms.fd + OVMF_VARS.ms.fd (set by `nix develop`).
# Other distros: e.g. /usr/share/OVMF with OVMF_CODE_4M.ms.fd -> set OVMF_CODE/OVMF_VARS.
OVMF_DIR="${WINVM_OVMF_DIR:-/usr/share/OVMF}"
OVMF_CODE="$OVMF_DIR/OVMF_CODE.ms.fd"
OVMF_VARS="$OVMF_DIR/OVMF_VARS.ms.fd"
OVMF_VARS_NO_SECURE_BOOT="$OVMF_DIR/OVMF_VARS.fd"   # no keys enrolled
# 1 = Secure Boot on (realistic). 0 = off, which kernel debugging and
# unsigned/test-signed drivers need. UEFI only; fixed at build time.
SECURE_BOOT=1

# --- Installation media -----------------------------------------------------
# The Windows ISO, edition and key come from images/<IMAGE>.env.
# If the ISO is missing, `winvm fetch`/`build` download it from Microsoft.
# For images from the consumer download page (win10) the language is as named
# on that page, e.g. "English" (en-US), "English International" (en-GB),
# "German"; it must contain WIN_UI_LANGUAGE. WIN_ISO_DOWNLOAD=0: never download.
WIN_ISO_DOWNLOAD=1
WIN_ISO_LANGUAGE="English"
WIN_ISO_SHA256=""             # optional: pin the ISO you built with (per image: images/<name>.local.env)

# VirtIO drivers + guest tools. Pinned to a release that still ships Win10 drivers.
VIRTIO_URL="https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/virtio-win-0.1.271-1/virtio-win-0.1.271.iso"
VIRTIO_ISO="$ROOT/iso/virtio-win-0.1.271.iso"
VIRTIO_SHA256="bbe6166ad86a490caefad438fef8aa494926cb0a1b37fa1212925cfd81656429"  # winvm fetch/build verify it

# --- Windows setup ----------------------------------------------------------
# Edition, product key and computer name: images/<IMAGE>.env.
WIN_USER="dev"
WIN_PASSWORD="dev"            # only reachable via 127.0.0.1 port forwards; avoid & < > "
WIN_ADMIN_GROUP="Administrators"   # localized on non-English ISOs (de: "Administratoren")

# UI language must exist on the ISO (evaluation images pick their ISO by it).
# Input locale = keyboard layout (e.g. de-DE).
WIN_UI_LANGUAGE="en-US"
WIN_INPUT_LOCALE="en-US"
WIN_SYSTEM_LOCALE="en-US"
WIN_USER_LOCALE="en-US"
WIN_TIMEZONE="UTC"            # e.g. "W. Europe Standard Time"

# 1 = turn off automatic Windows Update and Store app updates so the VM state stays put.
DISABLE_WINDOWS_UPDATE=1

# 1 = remove preinstalled consumer apps (provision/remove-apps.txt) and turn off
#     ads, suggestions, auto-installed "suggested" apps, Bing in Start, Cortana,
#     News & Interests, OneDrive, and telemetry beyond the minimum.
DEBLOAT=1

# --- Network ----------------------------------------------------------------
# 1 = the guest gets internet access (NAT through the host).
# 0 = isolated: no outbound connections at all; SSH/RDP from the host still
#     work. Override per boot with `winvm start --online / --offline`.
VM_INTERNET=1
# Same for the installation: 0 = isolated/air-gapped install from the ISO and
# cache/ only (no Chocolatey, no updates). Override with `build --offline/--online`.
BUILD_INTERNET=1
# 1 = install all Windows updates during the build (online builds only), so a
# (re)built base image is fully patched. Override with `build --no-updates`.
BUILD_UPDATES=1

# --- Runtime ----------------------------------------------------------------
# Host ports on 127.0.0.1 for the VM "default"; the VM in slot N
# (winvm -n NAME, see `winvm list`) uses PORT + N.
SSH_PORT=2222                 # -> guest :22
RDP_PORT=33890                # -> guest :3389
VSDEBUG_PORT=40260            # -> guest Visual Studio remote debugger
DBGSRV_PORT=50050             # -> guest WinDbg process server
KD_PORT=50150                 # COM1 for kernel debugging (start --kd)
GDB_PORT=12340                # QEMU gdb stub (start --gdb)
UIDRIVER_PORT=47230           # -> guest WinAppDriver (UI test automation)
PROXY_PORT=18080              # mitmproxy for `winvm proxy` (guest uses 10.0.2.2:PORT)
PROXY_WEB_PORT=18180          # its web UI
GUEST_VSDEBUG_PORT=4026       # msvsmon (VS 2026 remote debugger) is started on this port
GUEST_DBGSRV_PORT=5005
GUEST_UIDRIVER_PORT=4723      # WinAppDriver's usual port
# Sound card (Intel HD Audio, Windows' own driver) played through this host:
# pipewire | pa | alsa | none. Changing it makes existing RAM snapshots unloadable.
AUDIO="pipewire"
# USB devices passed through at every start, as VID:PID (see `winvm usb list`).
USB_DEVICES=""
DISPLAY_MODE="gtk"            # gtk | sdl | none   (none = headless, use rdp/ssh)
SHARE_DIR="$ROOT/share"       # exposed via RDP as \\tsclient\share
