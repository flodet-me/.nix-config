# Windows 11 Enterprise LTSC 2024, evaluation from the Microsoft Evaluation
# Center. Long-term servicing: no Store, no inbox consumer apps, few changes.
IMAGE_DESC="Windows 11 Enterprise LTSC 2024 (evaluation)"
WIN_ISO="$WINVM_HOME/iso/win11-ltsc.iso"
case $WIN_UI_LANGUAGE in
    en-GB) WIN_ISO_URL="https://go.microsoft.com/fwlink/?linkid=2289033&clcid=0x409&culture=en-us&country=us" ;;
    *)     WIN_ISO_URL="https://go.microsoft.com/fwlink/?linkid=2289029&clcid=0x409&culture=en-us&country=us"
           WIN_UI_LANGUAGE="en-US" ;;
esac
WIN_EDITION="Windows 11 Enterprise LTSC 2024 Evaluation"
WIN_PRODUCT_KEY=""
VIRTIO_OS="w11"
WIN_COMPUTER_NAME="LTSC-DEV"
REQUIRES_UEFI=1
