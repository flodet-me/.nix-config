# A recipe makes a special-purpose VM: winvm new NAME --recipe <this folder>
# Everything here is optional. See docs/custom-vms.md.

DESCRIPTION="what this VM is for"

# Windows version it starts from (winvm images). Default: IMAGE from config.env.
#IMAGE="win11"

# The VM's own settings, used whenever it starts (override config.env).
# Later changes: state/vms/NAME/vm.env
#VM_RAM="4G"
#VM_CPUS=2
#VM_INTERNET=0            # offline when it runs; installing the recipe still has internet
#USB_DEVICES="0951:1666"  # always attach these host USB devices (winvm usb list)
#AUDIO="pipewire"
