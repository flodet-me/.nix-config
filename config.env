# Default configuration for winvm.
# Don't edit this file for personal tweaks: put overrides in config.local.env
# (same syntax, gitignored, sourced after this file).

# --- VM hardware ------------------------------------------------------------
VM_NAME="win10-dev"
VM_CPUS=4
VM_RAM="8G"
VM_DISK_SIZE="80G"           # thin-provisioned qcow2, only grows as used

# --- Installation media -----------------------------------------------------
# Windows 10 ISO (download from https://www.microsoft.com/software-download/windows10ISO).
WIN_ISO="$ROOT/iso/win10.iso"
WIN_ISO_SHA256=""             # optional: pin the ISO you built with

# VirtIO drivers + guest tools. Pinned to a release that still ships Win10 drivers.
VIRTIO_URL="https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/virtio-win-0.1.271-1/virtio-win-0.1.271.iso"
VIRTIO_ISO="$ROOT/iso/virtio-win-0.1.271.iso"
VIRTIO_SHA256=""              # optional: pin after first download (winvm fetch prints it)

# --- Windows setup ----------------------------------------------------------
# Edition to install from a multi-edition ISO + matching *generic* install key
# (generic keys install but do not activate). Examples:
#   "Windows 10 Pro"        VK7JG-NPHTM-C97JM-9MPGT-3V66T
#   "Windows 10 Home"       YTMG3-N6DKC-DKB77-7M9GH-8HVX7   (no RDP server!)
#   Enterprise evaluation   leave WIN_PRODUCT_KEY empty
WIN_EDITION="Windows 10 Pro"
WIN_PRODUCT_KEY="VK7JG-NPHTM-C97JM-9MPGT-3V66T"

WIN_USER="dev"
WIN_PASSWORD="dev"            # only reachable via 127.0.0.1 port forwards; avoid & < > "
WIN_COMPUTER_NAME="WIN10-DEV"
WIN_ADMIN_GROUP="Administrators"   # localized on non-English ISOs (de: "Administratoren")

# UI language must exist on the ISO. Input locale = keyboard layout (e.g. de-DE).
WIN_UI_LANGUAGE="en-US"
WIN_INPUT_LOCALE="en-US"
WIN_SYSTEM_LOCALE="en-US"
WIN_USER_LOCALE="en-US"
WIN_TIMEZONE="UTC"            # e.g. "W. Europe Standard Time"

# 1 = turn off automatic Windows Update so the VM state stays put.
DISABLE_WINDOWS_UPDATE=1

# --- Runtime ----------------------------------------------------------------
SSH_PORT=2222                 # host 127.0.0.1:SSH_PORT -> guest :22
RDP_PORT=33890                # host 127.0.0.1:RDP_PORT -> guest :3389
DISPLAY_MODE="gtk"            # gtk | sdl | none   (none = headless, use rdp/ssh)
SHARE_DIR="$ROOT/share"       # exposed via RDP as \\tsclient\share
