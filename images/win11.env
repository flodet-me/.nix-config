# Windows 11 Enterprise, 90-day evaluation from the Microsoft Evaluation Center
# (official, no key, downloads automatically). Needs FIRMWARE=uefi (TPM + Secure Boot).
IMAGE_DESC="Windows 11 Enterprise (evaluation)"
WIN_ISO="$ROOT/iso/win11.iso"
case $WIN_UI_LANGUAGE in
    en-GB) WIN_ISO_URL="https://go.microsoft.com/fwlink/?LinkId=2382700&clcid=0x409&culture=en-us&country=us" ;;
    *)     WIN_ISO_URL="https://go.microsoft.com/fwlink/?LinkId=2382600&clcid=0x409&culture=en-us&country=us"
           WIN_UI_LANGUAGE="en-US" ;;   # the ISO only contains this language
esac
WIN_EDITION="Windows 11 Enterprise Evaluation"
WIN_PRODUCT_KEY=""
VIRTIO_OS="w11"
WIN_COMPUTER_NAME="WIN11-DEV"
REQUIRES_UEFI=1
