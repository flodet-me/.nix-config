# Windows 11 (Pro by default) from Microsoft's consumer download page: installs
# with the generic key, isn't activated, and doesn't expire (unlike the 90-day
# Enterprise evaluation). Put your own key in images/win11.local.env to activate.
# Needs FIRMWARE=uefi (TPM + Secure Boot).
IMAGE_DESC="Windows 11 Pro"
WIN_ISO="$ROOT/iso/win11-pro.iso"
WIN_ISO_PAGE="windows11"      # automatic download via microsoft.com/software-download/<page>
# The Windows 11 page names British English differently than the Windows 10 one.
[[ $WIN_ISO_LANGUAGE == "English International" ]] && WIN_ISO_LANGUAGE="English (United Kingdom)"
# Edition from the multi-edition ISO + matching *generic* key (installs, doesn't activate):
#   "Windows 11 Pro"   VK7JG-NPHTM-C97JM-9MPGT-3V66T
#   "Windows 11 Home"  YTMG3-N6DKC-DKB77-7M9GH-8HVX7   (no RDP server!)
WIN_EDITION="Windows 11 Pro"
WIN_PRODUCT_KEY="VK7JG-NPHTM-C97JM-9MPGT-3V66T"
VIRTIO_OS="w11"
WIN_COMPUTER_NAME="WIN11-DEV"
REQUIRES_UEFI=1
