{
  "model": "claude-opus-5-5",
  "advisorModel": "fable",
  "effortLevel": "high",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "switchModelsOnFlag": false,
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__claude-artifacts",
      "mcp__claude-vscode",
      "mcp__claude_ai_Claude_Docs"
    ],
    "deny": [
      "Bash(blkdiscard *)",
      "Bash(btrfs subvolume delete *)",
      "Bash(cat /proc/*/environ)",
      "Bash(cat /run/secrets-for-users/*)",
      "Bash(cat /run/secrets/*)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat ~/.claude/.credentials.json)",
      "Bash(cat ~/.config/gh/*)",
      "Bash(cat ~/.git-credentials)",
      "Bash(cat ~/.gnupg/*)",
      "Bash(cat ~/.netrc)",
      "Bash(cat ~/.ssh/*)",
      "Bash(chmod -R * /)",
      "Bash(chown -R * /)",
      "Bash(cryptsetup *)",
      "Bash(dd * of=/dev/*)",
      "Bash(disko *)",
      "Bash(doas *)",
      "Bash(env)",
      "Bash(fdisk *)",
      "Bash(gh auth *)",
      "Bash(gh auth token *)",
      "Bash(gh auth token)",
      "Bash(gh repo delete *)",
      "Bash(gh secret *)",
      "Bash(git credential *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(gpg --card-edit *)",
      "Bash(gpg --delete-secret-and-public-keys *)",
      "Bash(gpg --delete-secret-keys *)",
      "Bash(gpg --edit-card *)",
      "Bash(gpg --export-secret-keys *)",
      "Bash(gpg --export-secret-subkeys *)",
      "Bash(halt *)",
      "Bash(halt)",
      "Bash(kill -1)",
      "Bash(kill -9 -1)",
      "Bash(kill -KILL -1)",
      "Bash(killall5 *)",
      "Bash(loginctl terminate-* *)",
      "Bash(mkfs *)",
      "Bash(mkfs.* *)",
      "Bash(mkswap *)",
      "Bash(mullvad account *)",
      "Bash(nix store delete *)",
      "Bash(nix-collect-garbage *)",
      "Bash(nix-store --delete *)",
      "Bash(nixos-rebuild *)",
      "Bash(parted *)",
      "Bash(pkexec *)",
      "Bash(pkill -u *)",
      "Bash(poweroff *)",
      "Bash(poweroff)",
      "Bash(printenv *)",
      "Bash(printenv)",
      "Bash(reboot *)",
      "Bash(reboot)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/*)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~/*)",
      "Bash(run0 *)",
      "Bash(sgdisk *)",
      "Bash(shred *)",
      "Bash(shutdown *)",
      "Bash(shutdown)",
      "Bash(sops --decrypt *)",
      "Bash(sops -d *)",
      "Bash(sops decrypt *)",
      "Bash(sops exec-env *)",
      "Bash(sops exec-file *)",
      "Bash(su *)",
      "Bash(su)",
      "Bash(sudo *)",
      "Bash(systemctl halt *)",
      "Bash(systemctl hibernate *)",
      "Bash(systemctl kexec *)",
      "Bash(systemctl poweroff *)",
      "Bash(systemctl reboot *)",
      "Bash(systemctl suspend *)",
      "Bash(wipefs *)",
      "Bash(ykman *)",
      "Edit(/etc/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(/etc/ssh/ssh_host_*_key)",
      "Read(/persist/etc/ssh/**)",
      "Read(/persist/var/lib/sops-nix/**)",
      "Read(/run/secrets-for-users/**)",
      "Read(/run/secrets/**)",
      "Read(/var/lib/sops-nix/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/sops/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
      "Read(~/.ssh/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "remoteControlAtStartup": true,
  "tui": "fullscreen",
  "viewMode": "focus"
}
